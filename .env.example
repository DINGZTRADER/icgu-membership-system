##############################################################
# ICGU Membership Management System — Environment Configuration
# Target: Supabase PostgreSQL + Laravel Cloud (Free Tier)
##############################################################

APP_NAME="ICGU Membership System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=Africa/Kampala

# ─────────────────────────────────────────────────────────────
# DATABASE — Supabase PostgreSQL (External Connection)
# Replace [PROJECT-REF] with your Supabase project reference ID.
# Port 5432 = direct connection (free tier).
# Port 6543 = PgBouncer pooler (use for serverless environments).
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=[PROJECT-REF].supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]
DB_SCHEMA=public

# Supabase PgBouncer Pooler (Transaction Mode — recommended for serverless)
# Uncomment and use these settings on Laravel Cloud to prevent connection exhaustion.
# DB_HOST=[PROJECT-REF].pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.[PROJECT-REF]

# SSL — Always enforce SSL on Supabase connections
DB_SSLMODE=require

# ─────────────────────────────────────────────────────────────
# CACHE & SESSIONS
# Use 'database' driver to avoid Redis costs on free tier.
# ─────────────────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ─────────────────────────────────────────────────────────────
# QUEUE
# Use 'sync' for prototype (no worker processes needed).
# Switch to 'database' when moving to production.
# ─────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ─────────────────────────────────────────────────────────────
# MAIL — Mailtrap for prototype; swap to Postmark in production
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="secretary@icgu.org"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────
# SERVERLESS OPTIMISATIONS (Laravel Cloud)
# These settings prevent cold-start connection failures.
# ─────────────────────────────────────────────────────────────
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# Octane (if used for performance) — leave blank on basic Cloud tier
OCTANE_SERVER=
