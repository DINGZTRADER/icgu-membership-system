APP_NAME="ICGU Membership System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud
APP_TIMEZONE=Africa/Kampala
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Supabase PostgreSQL. Copy the Session Pooler connection string from Supabase > Connect.
DB_CONNECTION=pgsql
DB_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
DB_SCHEMA=icgu
DB_SSLMODE=require

# Before first Laravel migration, run database/bootstrap/supabase.sql once on the target database.
# Optional Supabase API access for future server-side storage/operations. Never expose sb_secret_* in client code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Private application documents. `local` is only acceptable on a genuinely persistent encrypted volume.
FILESYSTEM_DISK=local
MEMBERSHIP_DOCUMENT_DISK=local
PRODUCTION_ALLOW_LOCAL_DOCUMENT_STORAGE=false

# Controlled pilot migration. Keep batches deliberately small until ICGU signs off broader migration.
PILOT_IMPORT_MAX_ROWS=50

# Session cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Email. Laravel 12 accepts smtp/smtps for MAIL_SCHEME; smtp on 587 negotiates STARTTLS when offered.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="icgu@icgu.org"
MAIL_FROM_NAME="Institute of Corporate Governance Uganda"
PRODUCTION_REQUIRE_LIVE_MAIL=true

# MTN MoMo Collections. Keep disabled until ICGU's Uganda merchant/API account is onboarded.
MTN_MOMO_ENABLED=false
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL="${APP_URL}/api/integrations/mtn-momo/callback"
MTN_MOMO_CURRENCY=UGX
MTN_MOMO_TIMEOUT_SECONDS=15
PRODUCTION_REQUIRE_MTN_MOMO=false

# Airtel Money remains disabled until current Uganda merchant API credentials/contract are supplied.
AIRTEL_MONEY_ENABLED=false
AIRTEL_MONEY_BASE_URL=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX

# Optional SMS provider using a server-side HTTPS gateway configured by ICGU.
SMS_ENABLED=false
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_SENDER=ICGU

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12
