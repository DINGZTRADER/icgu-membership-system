APP_NAME="ICGU Membership System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud
APP_TIMEZONE=Africa/Kampala
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Supabase PostgreSQL.
# Copy the Session Pooler connection string from Supabase > Connect rather than typing it manually.
DB_CONNECTION=pgsql
DB_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres
DB_SCHEMA=icgu
DB_SSLMODE=require

# Before first Laravel migration, run database/bootstrap/supabase.sql once on the target database.

# Private application documents. Keep this non-public in production.
FILESYSTEM_DISK=local
MEMBERSHIP_DOCUMENT_DISK=local

# Session cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="secretary@icgu.org"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12
