APP_NAME="ICGU Membership System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.laravel.cloud
APP_TIMEZONE=Africa/Kampala

# Supabase PostgreSQL. Prefer DB_URL copied from Supabase Connect.
DB_CONNECTION=pgsql
DB_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
DB_SCHEMA=icgu
DB_SSLMODE=require

# Session cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="secretary@icgu.org"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=info
BCRYPT_ROUNDS=12
